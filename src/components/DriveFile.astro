---
/**
 * A surviving Google Drive attachment. Rendered as a link rather than an
 * embed — Drive's preview iframe is slow and frequently blocked, and these
 * are mostly worksheets people will want to open in a new tab anyway.
 */
interface Props {
  id: string;
  title: string;
}
const { id, title } = Astro.props;
---

<a class="drive" href={`https://drive.google.com/file/d/${id}/view`} target="_blank" rel="noopener noreferrer">
  <svg class="icon" viewBox="0 0 24 24" aria-hidden="true">
    <path d="M14 3H7a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V8z" />
    <path d="M14 3v5h5M9 13h6M9 17h6" />
  </svg>
  <span>{title}</span>
  <span class="ext muted">Google Drive &rarr;<span class="sr-only"> (opens in a new tab)</span></span>
</a>

<style>
  .drive {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 0.7rem 0.9rem;
    margin: 1rem 0;
    text-decoration: none;
    color: var(--text);
    background: var(--bg-subtle);
  }
  .drive:hover { border-color: var(--accent); }
  .icon {
    flex: none;
    width: 1.1rem;
    height: 1.1rem;
    fill: none;
    stroke: var(--text-muted);
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .ext { margin-left: auto; font-size: var(--fs-caption); white-space: nowrap; }
</style>
