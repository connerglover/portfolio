---
/**
 * Top nav for every page except home.
 *
 * Projects and School each carry a dropdown listing what is under them. The
 * menus open on hover and on keyboard focus (`:focus-within`), so they need no
 * JavaScript and nothing to re-initialise after a view transition. Each trigger
 * is a real link to its index page, which is what a click or a tap gets you;
 * below 52rem the menus are dropped and the index pages carry the navigation.
 */
import { getCollection } from 'astro:content';
import { site, courses } from '../data/site';

const path = Astro.url.pathname;
const isUnder = (href: string) => path.startsWith(href);

const projects = (await getCollection('projects', (p) => !p.data.draft)).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);

const groups = [
  {
    label: 'Projects',
    href: '/projects/',
    items: projects.map((p) => ({
      href: `/projects/${p.id}/`,
      hint: String(p.data.date.getFullYear()),
      label: p.data.title,
    })),
  },
  {
    label: 'School',
    href: '/school/',
    items: courses.map((c) => ({
      href: `/school/${c.slug}/`,
      hint: c.short,
      label: c.name,
    })),
  },
];
---

<header class="site-header glass-edge">
  <div class="wrap bar">
    <a class="brand" href="/">{site.name}</a>

    <nav aria-label="Primary">
      <ul class="top">
        {groups.map((g) => (
          <li class="has-menu">
            <a href={g.href} class="menu-trigger" aria-current={isUnder(g.href) ? 'page' : undefined}>
              {g.label}
              <svg viewBox="0 0 24 24" aria-hidden="true" class="caret"><path d="M6 9l6 6 6-6" /></svg>
            </a>
            <ul class="menu glass-edge">
              {g.items.map((it) => (
                <li>
                  <a href={it.href} aria-current={path === it.href ? 'page' : undefined}>
                    <span class="hint">{it.hint}</span>
                    <span class="full">{it.label}</span>
                  </a>
                </li>
              ))}
            </ul>
          </li>
        ))}
        <li><a href="/about/" aria-current={isUnder('/about/') ? 'page' : undefined}>About</a></li>
      </ul>

      {/* Narrow screens have no hover, so the menus are dropped. */}
      <ul class="flat">
        {groups.map((g) => (
          <li><a href={g.href} aria-current={isUnder(g.href) ? 'page' : undefined}>{g.label}</a></li>
        ))}
        <li><a href="/about/" aria-current={isUnder('/about/') ? 'page' : undefined}>About</a></li>
      </ul>
    </nav>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 20;
    border-bottom: 1px solid var(--glass-rim);
  }

  /* The glass is a layer behind the bar rather than a property of it.
     An element with backdrop-filter becomes a backdrop root for everything
     inside it, so putting the blur on .site-header would leave the dropdown
     menus unable to blur the page — they would only ever see the header. As a
     sibling of the content in paint order it blurs the page normally and
     leaves the menus a backdrop of their own.
     The --bg layer under the tint is what the inline panes do not need: the
     page scrolls under this one, and a heading passing beneath 6.5% white
     would show straight through. With nothing scrolled under it the two
     composite to the same colour, so the bar and the contents box match. */
  .site-header::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background:
      linear-gradient(var(--glass-tint-lit), var(--glass-tint-lit)),
      color-mix(in srgb, var(--bg) 70%, transparent);
    -webkit-backdrop-filter: blur(var(--glass-blur));
    backdrop-filter: blur(var(--glass-blur));
  }
  /* The bar's lit edge is its bottom border and nothing else. The shared ring
     draws all four sides, which on a full-bleed sticky bar would run a line up
     both viewport edges and across the very top of the page. Reshaped rather
     than opted out of, so the light still tracks the cursor along the one edge
     the bar actually has — including from below it, since the gradient is
     placed in the header's own coordinates and simply falls off with distance. */
  .site-header::after {
    inset: auto 0 -1px;
    height: 1px;
    padding: 0;
    border-radius: 0;
    -webkit-mask: none;
    mask: none;
    /* Behind the bar's contents. An open dropdown hangs from a trigger inside
       the bar and starts a few pixels above the bar's own bottom edge, so at
       the default z-index this strip — generated content, and therefore last
       in paint order — drew itself straight across the top of the menu.
       Negative keeps it above the ::before glass, which is earlier in the DOM
       at the same index, while putting it under anything positioned. */
    z-index: -1;
  }

  .bar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    padding-block: 0.9rem;
  }
  .brand {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 1.02rem;
    letter-spacing: -0.02em;
    color: var(--text);
    border: 0;
  }
  .brand:hover { color: var(--accent-bright); }

  nav ul {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1.4rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  nav a {
    position: relative;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--text-faint);
    border: 0;
  }
  .top > li > a::after {
    content: '';
    position: absolute;
    left: 0;
    right: 100%;
    bottom: -0.35rem;
    height: 1px;
    background: var(--accent);
    transition: right var(--dur) var(--ease);
  }
  nav a:hover { color: var(--text); }
  .top > li > a:hover::after { right: 0; }
  nav a[aria-current='page'] { color: var(--accent-bright); }
  .top > li > a[aria-current='page']::after { right: 0; }

  /* ---------- dropdowns ---------- */

  .has-menu { position: relative; }
  .menu-trigger {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
  }
  .caret {
    width: 0.85rem;
    height: 0.85rem;
    fill: none;
    stroke: currentColor;
    stroke-width: 2.5;
    stroke-linecap: round;
    stroke-linejoin: round;
    transition: transform var(--dur) var(--ease);
  }
  .has-menu:hover .caret,
  .has-menu:focus-within .caret { transform: rotate(180deg); }

  /* Qualified as `nav ul.menu`, not `.menu`. Astro scopes styles by appending a
     data attribute to every selector, which lifts the `nav ul` rule above a
     bare class — so `display: flex` and its 1.4rem gap would win and lay the
     menu out as a row. */
  nav ul.menu {
    position: absolute;
    top: calc(100% + 0.7rem);
    /* Anchored right: the titles make these menus wide, and growing rightward
       runs them off the viewport. */
    right: -0.6rem;
    display: block;
    gap: 0;
    /* Shorter than the 300px default: a menu is a fraction of the width of the
       bar or the contents box, and at the default the whole ring would light
       at once rather than the edge nearest the cursor. */
    --rim-reach: 200px;
    min-width: max-content;
    padding: 0.35rem;
    border: 1px solid var(--glass-rim);
    border-radius: var(--radius);
    /* Same material as the header above it and the contents box below, with
       the same --bg layer for the same reason: a menu floats over whatever
       happens to be on the page. The shadow stays heavier than --glass-shadow
       because this one is genuinely off the page rather than set into it. */
    background:
      linear-gradient(var(--glass-tint-lit), var(--glass-tint-lit)),
      color-mix(in srgb, var(--bg) 74%, transparent);
    -webkit-backdrop-filter: blur(var(--glass-blur));
    backdrop-filter: blur(var(--glass-blur));
    box-shadow: 0 12px 32px rgb(0 0 0 / 0.45);
    opacity: 0;
    visibility: hidden;
    transform: translateY(-4px);
    transition:
      opacity var(--dur) var(--ease),
      transform var(--dur) var(--ease),
      visibility var(--dur);
  }
  .has-menu:hover ul.menu,
  .has-menu:focus-within ul.menu {
    opacity: 1;
    visibility: visible;
    transform: translateY(0);
  }
  /* Keeps the pointer from falling through the gap between trigger and menu. */
  nav ul.menu::before {
    content: '';
    position: absolute;
    inset: -0.8rem 0 auto;
    height: 0.8rem;
  }

  .menu li { width: 100%; }
  .menu a {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    padding: 0.42rem 0.6rem;
    border-radius: var(--radius-sm);
    text-transform: none;
    letter-spacing: 0;
    white-space: nowrap;
    transition: background var(--dur) var(--ease), color var(--dur) var(--ease);
  }
  .menu a:hover { background: var(--glass-tint-lit); color: var(--text); }
  .menu .hint {
    flex: none;
    width: 2.6rem;
    font-size: 0.68rem;
    letter-spacing: 0.08em;
    color: var(--accent);
  }
  .menu .full {
    font-family: var(--font-sans);
    font-size: 0.86rem;
  }

  /* ---------- narrow screens ---------- */

  nav ul.flat { display: none; }

  @media (max-width: 52rem) {
    nav ul.top { display: none; }
    nav ul.flat { display: flex; gap: 1.2rem; }
    nav ul.flat a { font-size: 0.72rem; letter-spacing: 0.08em; }
  }
</style>
