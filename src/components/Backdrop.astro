---
/**
 * The page backdrop: a drifting dot field with a green trail that lights the
 * dots it passes over.
 *
 * The dots are a simplex noise flow field, the same technique antfu.me uses.
 * Each dot has a home position on a fixed grid and is pushed off it by an
 * angle and a distance both read from 3D noise, with time as the third
 * dimension. Because the noise is smooth in space and in time, neighbouring
 * dots move together and the field drifts like a slow current instead of
 * flickering. Alpha comes off the same angle, so it breathes as well as moves.
 *
 * Drawn on a plain 2D canvas rather than with a WebGL particle library: at
 * this dot count the cost is in the noise calls, not the fills, and it keeps
 * the dependency down to one small noise function.
 *
 * The pointer is tracked with easing so the lit patch lags behind the cursor
 * and reads as a trail. The wash behind it is CSS, at a radius deliberately
 * matched to the lit dots so the two read as a single light.
 */
---

<div class="backdrop" aria-hidden="true">
  <canvas class="field"></canvas>
  <div class="wash"></div>
</div>

<style>
  .backdrop {
    position: fixed;
    inset: 0;
    z-index: 0;
    pointer-events: none;
  }
  .field {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    transition:
      opacity 320ms var(--ease),
      filter 320ms var(--ease);
  }

  .wash {
    position: absolute;
    inset: 0;
    opacity: 0;
    /* Slower than the dim below would feel like lag, faster than this loses the
       gentle first appearance. */
    transition: opacity 420ms var(--ease);
    background: radial-gradient(
      var(--glow-r, 200px) var(--glow-r, 200px) at var(--gx, 50%) var(--gy, -20%),
      rgb(16 185 129 / 0.07),
      transparent 70%
    );
  }
  .backdrop.on .wash { opacity: 1; }

  @media (prefers-reduced-motion: reduce) {
    .wash { display: none; }
  }
</style>

<style is:global>
  /**
   * While a project row is hovered, the dot field steps back so the row is the
   * only lit thing on screen.
   *
   * Global rather than scoped because the trigger — `.feature` — belongs to
   * FeatureList, and Astro would scope that half of the selector to this
   * component and match nothing. Same `:has()` the list already uses to dim its
   * own siblings, so hover state stays in one place and costs no JavaScript.
   *
   * Opacity does the work; the desaturation is small and only stops the
   * remaining dots reading as green confetti behind an already green row.
   */
  :root:has(.feature > li > a:hover) .backdrop .field {
    opacity: 0.22;
    filter: saturate(0.35);
  }
  :root:has(.feature > li > a:hover) .backdrop .wash {
    opacity: 0.15;
  }
</style>

<script>
  import { createNoise3D } from 'simplex-noise';

  const SPACING = 18;   // px between dots at rest
  const SCALE = 200;    // noise feature size — how far the current reaches
  const LENGTH = 5;     // max px a dot drifts from home
  const GLOW_R = 200;   // radius of the lit patch; the CSS wash matches it
  const DOT = 1.6;      // px
  const BUCKETS = 6;    // alpha quantisation, to batch canvas state changes

  const still = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const fine = window.matchMedia('(pointer: fine)').matches;

  const noise3d = createNoise3D();

  // State lives at module scope so it survives client-side navigation. The
  // elements do not — Astro replaces them on every page load — so they get
  // re-resolved in bind().
  let backdrop: HTMLElement | null = null;
  let canvas: HTMLCanvasElement | null = null;
  let ctx: CanvasRenderingContext2D | null = null;

  let w = 0;
  let h = 0;
  let cols = 0;
  let rows = 0;
  let seeds = new Float32Array(0);

  let tx = -9999;
  let ty = -9999;
  let px = -9999;
  let py = -9999;
  let running = false;

  const resize = () => {
    if (!canvas || !ctx) return;
    const dpr = Math.min(window.devicePixelRatio || 1, 2);
    w = window.innerWidth;
    h = window.innerHeight;
    canvas.width = Math.round(w * dpr);
    canvas.height = Math.round(h * dpr);
    ctx.setTransform(dpr, 0, 0, dpr, 0, 0);

    cols = Math.ceil(w / SPACING) + 2;
    rows = Math.ceil(h / SPACING) + 2;
    // A fixed opacity per dot, so the field has texture rather than reading as
    // a perfectly even grid.
    seeds = new Float32Array(cols * rows);
    for (let i = 0; i < seeds.length; i++) seeds[i] = Math.random() * 0.5 + 0.5;
  };

  const paintBucket = (list: number[][], colour: string, maxAlpha: number) => {
    if (!ctx) return;
    for (let b = 0; b < BUCKETS; b++) {
      const pts = list[b];
      if (pts.length === 0) continue;
      ctx.globalAlpha = ((b + 1) / BUCKETS) * maxAlpha;
      ctx.fillStyle = colour;
      for (let i = 0; i < pts.length; i += 2) ctx.fillRect(pts[i], pts[i + 1], DOT, DOT);
    }
  };

  const draw = (time: number) => {
    if (!ctx) return;
    const t = time / 10000;
    ctx.clearRect(0, 0, w, h);

    const lit = fine && !still && px > -5000;

    // Two passes. The grey field is bucketed by alpha so the whole thing costs
    // a handful of canvas state changes rather than one per dot; the emerald
    // pass only collects dots inside the glow radius.
    const grey: number[][] = [];
    const green: number[][] = [];
    for (let i = 0; i < BUCKETS; i++) {
      grey.push([]);
      green.push([]);
    }

    for (let cx = 0; cx < cols; cx++) {
      const hx = cx * SPACING - SPACING / 2;
      for (let cy = 0; cy < rows; cy++) {
        const hy = cy * SPACING - SPACING / 2;

        const rad = (noise3d(hx / SCALE, hy / SCALE, t) - 0.5) * 2 * Math.PI;
        const len = (noise3d(hx / SCALE, hy / SCALE, t * 2) + 0.5) * LENGTH;
        const x = hx + Math.cos(rad) * len;
        const y = hy + Math.sin(rad) * len;

        const seed = seeds[cx * rows + cy] || 0.75;
        const a = (Math.abs(Math.cos(rad)) * 0.8 + 0.2) * seed;

        let near = 0;
        if (lit) {
          const d = Math.hypot(x - px, y - py);
          if (d < GLOW_R) {
            near = 1 - d / GLOW_R;
            near *= near; // falls off faster than linear so the core reads
          }
        }

        if (near > 0.02) {
          const b = Math.min(BUCKETS - 1, Math.floor((0.3 + near * 0.7) * a * BUCKETS * 1.7));
          green[b].push(x, y);
        } else {
          const b = Math.min(BUCKETS - 1, Math.floor(a * BUCKETS));
          grey[b].push(x, y);
        }
      }
    }

    paintBucket(grey, '#ffffff', 0.14);
    paintBucket(green, '#34d399', 0.95);
    ctx.globalAlpha = 1;
  };

  const frame = (time: number) => {
    if (!canvas || !ctx) {
      running = false;
      return;
    }
    if (tx > -5000) {
      if (px < -5000) {
        px = tx;
        py = ty;
      }
      // Ease toward the pointer. That lag is the trail.
      px += (tx - px) * 0.12;
      py += (ty - py) * 0.12;
      backdrop?.style.setProperty('--gx', `${px}px`);
      backdrop?.style.setProperty('--gy', `${py}px`);
    }
    draw(still ? 0 : time);
    if (still) {
      // One static frame is enough when motion is not wanted.
      running = false;
      return;
    }
    requestAnimationFrame(frame);
  };

  const kick = () => {
    if (running || !ctx) return;
    running = true;
    requestAnimationFrame(frame);
  };

  if (fine && !still) {
    window.addEventListener('pointermove', (e) => {
      tx = e.clientX;
      ty = e.clientY;
      backdrop?.classList.add('on');
      kick();
    }, { passive: true });
  }

  window.addEventListener('resize', () => {
    resize();
    kick();
  }, { passive: true });

  const bind = () => {
    backdrop = document.querySelector<HTMLElement>('.backdrop');
    canvas = backdrop?.querySelector<HTMLCanvasElement>('.field') ?? null;
    ctx = canvas?.getContext('2d') ?? null;
    if (!backdrop || !ctx) return;

    backdrop.style.setProperty('--glow-r', `${GLOW_R}px`);
    resize();
    // Restore the trail straight away — the element is new and carries none of
    // the previous state, so without this the effect stays dead until the
    // pointer happens to move again.
    if (px > -5000) {
      backdrop.style.setProperty('--gx', `${px}px`);
      backdrop.style.setProperty('--gy', `${py}px`);
      backdrop.classList.add('on');
    }
    running = false;
    kick();
  };

  document.addEventListener('astro:page-load', bind);
  bind();
</script>
