---
/**
 * A soft emerald light that follows the pointer behind the content.
 *
 * Only used on the home page — a quiet base with a couple of deliberate
 * moments is the brief, and this is one of them. Off for coarse pointers
 * (nothing to follow on a touchscreen) and off under reduced-motion.
 */
---

<div class="glow" aria-hidden="true"></div>

<style>
  .glow {
    position: fixed;
    inset: 0;
    z-index: 0;
    pointer-events: none;
    opacity: 0;
    transition: opacity 600ms var(--ease);
    background: radial-gradient(
      36rem 36rem at var(--gx, 50%) var(--gy, 0%),
      rgb(16 185 129 / 0.09),
      transparent 70%
    );
  }
  .glow.on { opacity: 1; }

  @media (pointer: coarse), (prefers-reduced-motion: reduce) {
    .glow { display: none; }
  }
</style>

<script>
  const glow = document.querySelector<HTMLElement>('.glow');
  const fine = window.matchMedia('(pointer: fine)').matches;
  const still = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (glow && fine && !still) {
    let x = 0;
    let y = 0;
    let queued = false;

    const paint = () => {
      queued = false;
      glow.style.setProperty('--gx', `${x}px`);
      glow.style.setProperty('--gy', `${y}px`);
    };

    window.addEventListener('pointermove', (e) => {
      x = e.clientX;
      y = e.clientY;
      glow.classList.add('on');
      if (queued) return;
      queued = true;
      requestAnimationFrame(paint);
    }, { passive: true });
  }
</script>
