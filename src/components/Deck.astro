---
/**
 * A PDF attachment, rendered from images rather than in a browser PDF frame.
 *
 * Browsers wrap a PDF in their own toolbar, thumbnail sidebar and print
 * controls, which reads as a document viewer bolted to the page — and most
 * mobile browsers refuse to render one inline at all. So
 * `scripts/render_decks.py` rasterises each page to WebP ahead of time and this
 * component presents those images.
 *
 * Two presentations, picked from the page's aspect ratio:
 *
 *   slides    landscape pages — one at a time, arrows, click to advance,
 *             keyboard and swipe, the way a slide embed behaves.
 *   document  portrait pages — reports, worksheets, scanned notes. These are
 *             documents, so they read as documents: sheets of paper stacked in
 *             a scrolling frame, with the page counter following the scroll.
 *
 * The PDF is still linked either way. Without JavaScript the pages stack down
 * the page and stay readable. A PDF with no rendered pages yet falls back to
 * the plain browser frame.
 */
import decks from '../data/decks.json';

interface Props {
  pdf: string;
  title?: string;
}
const { pdf, title } = Astro.props;
const label = title ?? 'Attachment';

const meta = (decks as Record<string, { pages: number; dir: string; width: number; height: number }>)[pdf];

// Anything taller than it is wide is a document, not a deck.
const isDocument = meta ? meta.height > meta.width : false;
const ratio = meta ? `${meta.width} / ${meta.height}` : '16 / 10';
const pages = meta
  ? Array.from({ length: meta.pages }, (_, i) => `${meta.dir}/p${String(i + 1).padStart(2, '0')}.webp`)
  : [];
const paged = meta ? meta.pages > 1 : false;
// The viewer takes focus and handles the keyboard, so it needs a name: what
// it is, how long it is, and that arrows work. Documents scroll instead.
const viewerLabel = meta
  ? isDocument
    ? `${label}, ${meta.pages}-page document. Scroll to read.`
    : `${label}, ${meta.pages} slide${meta.pages === 1 ? '' : 's'}. Use the arrow keys to move between slides.`
  : label;
---

<figure class="deck">
  {meta ? (
    <slide-deck
      class:list={['viewer', isDocument ? 'document' : 'slides']}
      data-variant={isDocument ? 'document' : 'slides'}
      data-pages={meta.pages}
      style={`--ratio: ${ratio}`}
      role="group"
      aria-label={viewerLabel}
    >
      <div class="stage" data-stage>
        {pages.map((src, i) => (
          <img
            src={src}
            alt={`${label} — page ${i + 1} of ${meta.pages}`}
            width={meta.width}
            height={meta.height}
            loading="lazy"
            decoding="async"
            draggable="false"
            class={i === 0 ? 'current' : undefined}
            data-i={i}
          />
        ))}
      </div>

      <div class="bar">
        {/* Slides get paging controls; a document is navigated by scrolling. */}
        {!isDocument && paged && (
          <>
            <button type="button" data-prev aria-label="Previous slide">
              <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M15 5l-7 7 7 7" /></svg>
            </button>
            <button type="button" data-next aria-label="Next slide">
              <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M9 5l7 7-7 7" /></svg>
            </button>
          </>
        )}
        {paged && (
          <span class="count" aria-live="polite">
            {isDocument && 'Page '}<span data-cur>1</span> / {meta.pages}
          </span>
        )}
        <span class="gap"></span>
        <button type="button" data-full aria-label="Full screen">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 9V4h5M20 9V4h-5M4 15v5h5M20 15v5h-5" /></svg>
        </button>
        <a href={pdf} target="_blank" rel="noopener noreferrer" class="pdf">PDF<span class="sr-only"> (opens in a new tab)</span></a>
      </div>
    </slide-deck>
  ) : (
    <div class="frame">
      <iframe src={`${pdf}#view=FitH`} title={label} loading="lazy"></iframe>
    </div>
  )}

  <figcaption>{label}</figcaption>
</figure>

<style>
  .deck { margin: 1.5rem 0; }

  figcaption {
    font-size: var(--fs-caption);
    color: var(--text-muted);
    margin-top: 0.5rem;
  }

  .viewer {
    display: block;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    overflow: hidden;
    background: var(--bg-subtle);
  }
  .viewer:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }

  /* ---------- slides ---------- */

  /* Only the current slide is in flow, done in CSS rather than by the script on
     hydration: if the slides start out visible the browser begins fetching every
     one near the viewport before the script can hide them, which on a unit page
     with a dozen decks is megabytes of slides nobody asked for. */
  .slides .stage {
    position: relative;
    aspect-ratio: var(--ratio);
    max-height: min(78vh, 900px);
    cursor: pointer;
    display: block;
  }
  .slides .stage img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: contain;
    display: none;
  }
  .slides .stage img.current { display: block; }

  /* ---------- document ---------- */

  .document .stage {
    max-height: min(78vh, 46rem);
    overflow-y: auto;
    overscroll-behavior: contain;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1rem;
    padding: 1rem;
    /* A slightly darker ground than the page so the sheets read as paper. */
    background: color-mix(in srgb, var(--bg-subtle) 70%, var(--border));
  }
  .document .stage img {
    display: block;
    width: 100%;
    max-width: 46rem;
    height: auto;
    background: #fff;
    border-radius: 2px;
    box-shadow: 0 1px 4px rgb(0 0 0 / 0.28);
  }

  /* ---------- control bar ---------- */

  .bar {
    display: flex;
    align-items: center;
    gap: 0.25rem;
    padding: 0.4rem 0.5rem;
    border-top: 1px solid var(--border);
    background: var(--bg);
  }
  .gap { flex: 1; }

  .bar button {
    display: grid;
    place-items: center;
    width: 2rem;
    height: 2rem;
    padding: 0;
    border: 0;
    border-radius: 4px;
    background: none;
    color: var(--text-muted);
    cursor: pointer;
  }
  .bar button:hover:not(:disabled) {
    background: var(--bg-subtle);
    color: var(--text);
  }
  .bar button:disabled { opacity: 0.35; cursor: default; }
  .bar svg {
    width: 1.05rem;
    height: 1.05rem;
    fill: none;
    stroke: currentColor;
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .count {
    font-size: var(--fs-small);
    color: var(--text-muted);
    font-variant-numeric: tabular-nums;
    padding-inline: 0.4rem;
  }

  .pdf {
    display: inline-flex;
    align-items: center;
    min-height: 2rem;
    font-size: var(--fs-small);
    color: var(--text-muted);
    text-decoration: none;
    padding: 0.25rem 0.5rem;
    border-radius: 4px;
  }

  /* A finger is not a cursor. 2rem controls are fine under a mouse; on touch
     they grow to the 44px the platforms ask for, and the bar grows with them. */
  @media (pointer: coarse) {
    .bar button,
    .pdf { min-height: 2.75rem; }
    .bar button { width: 2.75rem; }
  }
  .pdf:hover { background: var(--bg-subtle); color: var(--text); }

  /* ---------- fullscreen ---------- */

  /* Same palette as the page. Fullscreen used to swap in a blue-grey set of
     its own, so the viewer changed brand the moment it went full screen; now
     it only sheds its frame and lets the stage take the height. */
  .viewer:fullscreen {
    display: flex;
    flex-direction: column;
    border: 0;
    border-radius: 0;
    background: var(--bg);
  }
  .viewer:fullscreen .stage {
    flex: 1;
    max-height: none;
    min-height: 0;
  }
  .slides:fullscreen .stage { aspect-ratio: auto; }
  .viewer:fullscreen .bar { background: var(--bg); }
  .viewer:fullscreen .count,
  .viewer:fullscreen .pdf,
  .viewer:fullscreen button { color: var(--text); }

  /* ---------- no scripting ---------- */

  @media (scripting: none) {
    .slides .stage {
      position: static;
      aspect-ratio: auto;
      max-height: none;
      cursor: default;
    }
    .slides .stage img {
      position: static;
      display: block;
      width: 100%;
      height: auto;
      background: #fff;
    }
    .document .stage { max-height: none; overflow: visible; }
    .bar button,
    .count { display: none; }
  }

  /* ---------- fallback frame ---------- */

  .frame {
    aspect-ratio: 16 / 10;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    overflow: hidden;
    background: var(--bg-subtle);
  }
  .frame iframe { width: 100%; height: 100%; border: 0; display: block; }
</style>

<script>
  class SlideDeck extends HTMLElement {
    private slides: HTMLImageElement[] = [];
    private index = 0;

    connectedCallback() {
      this.slides = Array.from(this.querySelectorAll<HTMLImageElement>('.stage img'));
      if (this.slides.length === 0) return;

      const stage = this.querySelector<HTMLElement>('[data-stage]')!;
      const full = this.querySelector<HTMLButtonElement>('[data-full]')!;
      const cur = this.querySelector<HTMLElement>('[data-cur]');

      full.addEventListener('click', (e) => {
        e.stopPropagation();
        if (document.fullscreenElement === this) document.exitFullscreen();
        else this.requestFullscreen?.().catch(() => {});
      });

      if (this.dataset.variant === 'document') {
        this.setUpDocument(stage, cur);
      } else {
        this.setUpSlides(stage, cur);
      }
    }

    /**
     * Pages scroll; the counter reports whichever page crosses the middle of
     * the frame. Measured off scroll position rather than an
     * IntersectionObserver — a page is normally taller than the frame, so its
     * intersection ratio never reaches the thresholds you would want to watch.
     */
    private setUpDocument(stage: HTMLElement, cur: HTMLElement | null) {
      if (!cur) return;
      let queued = false;

      const update = () => {
        queued = false;
        const frame = stage.getBoundingClientRect();
        const middle = frame.top + frame.height / 2;
        let best = 0;
        let nearest = Infinity;
        this.slides.forEach((img, i) => {
          const r = img.getBoundingClientRect();
          const distance =
            r.top <= middle && r.bottom >= middle
              ? 0
              : Math.min(Math.abs(r.top - middle), Math.abs(r.bottom - middle));
          if (distance < nearest) {
            nearest = distance;
            best = i;
          }
        });
        cur.textContent = String(best + 1);
      };

      stage.addEventListener(
        'scroll',
        () => {
          if (queued) return;
          queued = true;
          requestAnimationFrame(update);
        },
        { passive: true },
      );
      update();
    }

    /** One slide at a time, with arrows, keyboard, click and swipe. */
    private setUpSlides(stage: HTMLElement, cur: HTMLElement | null) {
      // Absent on single-page attachments, which render no paging controls.
      const prev = this.querySelector<HTMLButtonElement>('[data-prev]');
      const next = this.querySelector<HTMLButtonElement>('[data-next]');

      this.tabIndex = 0;

      // `warm` preloads the next slide so paging feels instant. It is off for
      // the initial call: a unit page can carry a dozen decks, and warming
      // every one of them on load pulls megabytes of slides nobody has
      // scrolled to yet.
      const show = (i: number, warm = true) => {
        const n = this.slides.length;
        this.index = Math.max(0, Math.min(n - 1, i));
        this.slides.forEach((img, k) => img.classList.toggle('current', k === this.index));
        if (cur) cur.textContent = String(this.index + 1);
        if (prev) prev.disabled = this.index === 0;
        if (next) next.disabled = this.index === n - 1;
        if (warm) {
          const ahead = this.slides[this.index + 1];
          if (ahead) ahead.loading = 'eager';
        }
      };

      prev?.addEventListener('click', (e) => { e.stopPropagation(); show(this.index - 1); });
      next?.addEventListener('click', (e) => { e.stopPropagation(); show(this.index + 1); });

      // Clicking the slide advances, the way a Slides embed does.
      stage.addEventListener('click', () => show(this.index + 1));

      this.addEventListener('keydown', (e: KeyboardEvent) => {
        const keys = ['ArrowRight', 'ArrowLeft', 'Home', 'End', ' ', 'PageDown', 'PageUp'];
        if (!keys.includes(e.key)) return;
        e.preventDefault();
        if (e.key === 'ArrowRight' || e.key === ' ' || e.key === 'PageDown') show(this.index + 1);
        else if (e.key === 'ArrowLeft' || e.key === 'PageUp') show(this.index - 1);
        else if (e.key === 'Home') show(0);
        else show(this.slides.length - 1);
      });

      let x0 = 0;
      let y0 = 0;
      stage.addEventListener('touchstart', (e: TouchEvent) => {
        x0 = e.changedTouches[0].clientX;
        y0 = e.changedTouches[0].clientY;
      }, { passive: true });
      stage.addEventListener('touchend', (e: TouchEvent) => {
        const dx = e.changedTouches[0].clientX - x0;
        const dy = e.changedTouches[0].clientY - y0;
        if (Math.abs(dx) > 40 && Math.abs(dx) > Math.abs(dy)) show(this.index + (dx < 0 ? 1 : -1));
      }, { passive: true });

      show(0, false);
    }
  }

  if (!customElements.get('slide-deck')) {
    customElements.define('slide-deck', SlideDeck);
  }
</script>
