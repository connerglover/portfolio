---
/**
 * A slide deck, served as a self-hosted PDF.
 *
 * These were exported out of Google Slides during the migration. The originals
 * are locked to a carmelhs.org account — they return 401 to the public and
 * disappear when that account does — so the PDF in `public/decks/` is the
 * canonical copy. `id` is kept in frontmatter for provenance only.
 *
 * Rendered in an <iframe> — every desktop browser's built-in PDF viewer
 * handles that, where <object> is inconsistent. Mobile browsers frequently
 * refuse to render PDFs inline at all, so the caption always carries a direct
 * link out as well.
 */
interface Props {
  pdf: string;
  title?: string;
}
const { pdf, title } = Astro.props;
const label = title ?? 'Slide deck';
---

<figure class="deck">
  <div class="frame">
    <iframe src={`${pdf}#view=FitH`} title={label} loading="lazy"></iframe>
  </div>
  <figcaption>
    <span>{label}</span>
    <a href={pdf} target="_blank" rel="noopener noreferrer">Open PDF &rarr;</a>
  </figcaption>
</figure>

<style>
  .deck { margin: 1.25rem 0; }
  .frame {
    aspect-ratio: 16 / 10;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    overflow: hidden;
    background: var(--bg-subtle);
  }
  .frame iframe {
    width: 100%;
    height: 100%;
    border: 0;
    display: block;
  }
  figcaption {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1rem;
    justify-content: space-between;
    font-size: 0.85rem;
    color: var(--text-muted);
    margin-top: 0.5rem;
  }
</style>
