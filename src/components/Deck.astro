---
/**
 * A slide deck, shown as a slideshow rather than as a PDF document.
 *
 * The originals were exported out of Google Slides during the migration and
 * are locked to a school account, so the PDF in `public/decks/` is the
 * canonical copy. Browsers render a PDF in an <iframe> with their own toolbar,
 * sidebar and print controls wrapped around it, which reads as a document
 * viewer, not an embedded deck — and most mobile browsers refuse to render one
 * inline at all.
 *
 * So `scripts/render_decks.py` rasterises each page to WebP ahead of time and
 * this component flips through those images: one slide in view, arrows, a
 * counter, fullscreen, keyboard and swipe. The PDF is still linked for anyone
 * who wants the file.
 *
 * Without JavaScript the pages stack down the page and stay readable (see the
 * `scripting: none` block below). If a PDF has no rendered pages yet (added
 * but not re-rendered), it falls back to the plain browser frame.
 */
import decks from '../data/decks.json';

interface Props {
  pdf: string;
  title?: string;
}
const { pdf, title } = Astro.props;
const label = title ?? 'Slide deck';

const meta = (decks as Record<string, { pages: number; dir: string; width: number; height: number }>)[pdf];
const ratio = meta ? `${meta.width} / ${meta.height}` : '16 / 10';
const pages = meta
  ? Array.from({ length: meta.pages }, (_, i) => `${meta.dir}/p${String(i + 1).padStart(2, '0')}.webp`)
  : [];
---

<figure class="deck">
  {meta ? (
    <slide-deck class="viewer" data-pages={meta.pages} style={`--ratio: ${ratio}`}>
      <div class="stage" data-stage>
        {pages.map((src, i) => (
          <img
            src={src}
            alt={`${label} — slide ${i + 1} of ${meta.pages}`}
            loading="lazy"
            decoding="async"
            draggable="false"
            class={i === 0 ? 'current' : undefined}
            data-i={i}
          />
        ))}
      </div>

      <div class="bar">
        {/* A one-page attachment has nothing to page through, so it gets the
            fullscreen and PDF controls only. */}
        {meta.pages > 1 && (
          <>
            <button type="button" data-prev aria-label="Previous slide">
              <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M15 5l-7 7 7 7" /></svg>
            </button>
            <button type="button" data-next aria-label="Next slide">
              <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M9 5l7 7-7 7" /></svg>
            </button>
            <span class="count" aria-live="polite"><span data-cur>1</span> / {meta.pages}</span>
          </>
        )}
        <span class="gap"></span>
        <button type="button" data-full aria-label="Full screen">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 9V4h5M20 9V4h-5M4 15v5h5M20 15v5h-5" /></svg>
        </button>
        <a href={pdf} target="_blank" rel="noopener noreferrer" class="pdf">PDF</a>
      </div>
    </slide-deck>
  ) : (
    <div class="frame">
      <iframe src={`${pdf}#view=FitH`} title={label} loading="lazy"></iframe>
    </div>
  )}

  <figcaption>{label}</figcaption>
</figure>

<style>
  .deck { margin: 1.5rem 0; }

  figcaption {
    font-size: 0.85rem;
    color: var(--text-muted);
    margin-top: 0.5rem;
  }

  /* ---------- viewer ---------- */

  .viewer {
    display: block;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    overflow: hidden;
    background: var(--bg-subtle);
  }
  .viewer:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }

  /* Only the current slide is in flow. This is done in CSS rather than by the
     script on hydration: if the slides start out visible, the browser begins
     fetching every one that is near the viewport before the script can hide
     them, which on a unit page with a dozen decks is megabytes of slides
     nobody asked for. */
  .stage {
    position: relative;
    aspect-ratio: var(--ratio);
    /* Portrait attachments — scanned worksheets, reports — would otherwise
       make a stage taller than the window and push everything below it off
       screen. Capping the height letterboxes them into side gutters instead. */
    max-height: min(78vh, 900px);
    cursor: pointer;
    display: block;
  }
  .stage img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: contain;
    display: none;
  }
  .stage img.current { display: block; }

  /* With scripting off the controls cannot work, so let the pages stack down
     the page and stay readable instead. */
  @media (scripting: none) {
    .stage {
      position: static;
      aspect-ratio: auto;
      max-height: none;
      cursor: default;
    }
    .stage img {
      position: static;
      display: block;
      width: 100%;
      height: auto;
      background: #fff;
    }
    .bar button,
    .count { display: none; }
  }

  /* ---------- control bar ---------- */

  .bar {
    display: flex;
    align-items: center;
    gap: 0.25rem;
    padding: 0.4rem 0.5rem;
    border-top: 1px solid var(--border);
    background: var(--bg);
  }
  .gap { flex: 1; }

  .bar button {
    display: grid;
    place-items: center;
    width: 2rem;
    height: 2rem;
    padding: 0;
    border: 0;
    border-radius: 4px;
    background: none;
    color: var(--text-muted);
    cursor: pointer;
  }
  .bar button:hover:not(:disabled) {
    background: var(--bg-subtle);
    color: var(--text);
  }
  .bar button:disabled { opacity: 0.35; cursor: default; }
  .bar svg {
    width: 1.05rem;
    height: 1.05rem;
    fill: none;
    stroke: currentColor;
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .count {
    font-size: 0.8rem;
    color: var(--text-muted);
    font-variant-numeric: tabular-nums;
    padding-inline: 0.4rem;
  }

  .pdf {
    font-size: 0.78rem;
    color: var(--text-muted);
    text-decoration: none;
    padding: 0.25rem 0.5rem;
    border-radius: 4px;
  }
  .pdf:hover { background: var(--bg-subtle); color: var(--text); }

  /* ---------- fullscreen ---------- */

  .viewer:fullscreen {
    display: flex;
    flex-direction: column;
    border: 0;
    border-radius: 0;
    background: #0b0d10;
  }
  .viewer:fullscreen .stage {
    flex: 1;
    aspect-ratio: auto;
    max-height: none;
    min-height: 0;
  }
  .viewer:fullscreen .bar {
    background: #0b0d10;
    border-top-color: #2a2f36;
  }
  .viewer:fullscreen .count,
  .viewer:fullscreen .pdf,
  .viewer:fullscreen button { color: #c9d1d9; }

  /* ---------- fallback frame ---------- */

  .frame {
    aspect-ratio: 16 / 10;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    overflow: hidden;
    background: var(--bg-subtle);
  }
  .frame iframe { width: 100%; height: 100%; border: 0; display: block; }
</style>

<script>
  class SlideDeck extends HTMLElement {
    private slides: HTMLImageElement[] = [];
    private index = 0;

    connectedCallback() {
      this.slides = Array.from(this.querySelectorAll<HTMLImageElement>('.stage img'));
      if (this.slides.length === 0) return;

      const stage = this.querySelector<HTMLElement>('[data-stage]')!;
      const full = this.querySelector<HTMLButtonElement>('[data-full]')!;
      // Absent on single-page attachments, which render no paging controls.
      const prev = this.querySelector<HTMLButtonElement>('[data-prev]');
      const next = this.querySelector<HTMLButtonElement>('[data-next]');
      const cur = this.querySelector<HTMLElement>('[data-cur]');

      this.tabIndex = 0;

      // `warm` preloads the next slide so paging feels instant. It is off for
      // the initial call: a unit page can carry a dozen decks, and warming
      // every one of them on load pulls megabytes of slides nobody has
      // scrolled to yet. Hidden slides stay lazy until the reader pages into
      // the deck.
      const show = (i: number, warm = true) => {
        const n = this.slides.length;
        this.index = Math.max(0, Math.min(n - 1, i));
        this.slides.forEach((img, k) => img.classList.toggle('current', k === this.index));
        if (cur) cur.textContent = String(this.index + 1);
        if (prev) prev.disabled = this.index === 0;
        if (next) next.disabled = this.index === n - 1;
        if (warm) {
          const ahead = this.slides[this.index + 1];
          if (ahead) ahead.loading = 'eager';
        }
      };

      prev?.addEventListener('click', (e) => { e.stopPropagation(); show(this.index - 1); });
      next?.addEventListener('click', (e) => { e.stopPropagation(); show(this.index + 1); });

      // Clicking the slide advances, the way a Slides embed does.
      stage.addEventListener('click', () => show(this.index + 1));

      full.addEventListener('click', (e) => {
        e.stopPropagation();
        if (document.fullscreenElement === this) document.exitFullscreen();
        else this.requestFullscreen?.().catch(() => {});
      });

      this.addEventListener('keydown', (e: KeyboardEvent) => {
        const keys = ['ArrowRight', 'ArrowLeft', 'Home', 'End', ' ', 'PageDown', 'PageUp'];
        if (!keys.includes(e.key)) return;
        e.preventDefault();
        if (e.key === 'ArrowRight' || e.key === ' ' || e.key === 'PageDown') show(this.index + 1);
        else if (e.key === 'ArrowLeft' || e.key === 'PageUp') show(this.index - 1);
        else if (e.key === 'Home') show(0);
        else show(this.slides.length - 1);
      });

      // Horizontal swipe on touch.
      let x0 = 0;
      let y0 = 0;
      stage.addEventListener('touchstart', (e: TouchEvent) => {
        x0 = e.changedTouches[0].clientX;
        y0 = e.changedTouches[0].clientY;
      }, { passive: true });
      stage.addEventListener('touchend', (e: TouchEvent) => {
        const dx = e.changedTouches[0].clientX - x0;
        const dy = e.changedTouches[0].clientY - y0;
        if (Math.abs(dx) > 40 && Math.abs(dx) > Math.abs(dy)) show(this.index + (dx < 0 ? 1 : -1));
      }, { passive: true });

      show(0, false);
    }
  }

  if (!customElements.get('slide-deck')) {
    customElements.define('slide-deck', SlideDeck);
  }
</script>
