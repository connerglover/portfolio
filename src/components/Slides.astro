---
/**
 * Google Slides embed.
 *
 * Only rendered for decks that still exist — every deck the school deleted
 * was dropped from the content files during the migration, so there is no
 * "broken embed" state to handle here.
 */
interface Props {
  id: string;
  title?: string;
}
const { id, title } = Astro.props;
const src = `https://docs.google.com/presentation/d/${id}/embed?start=false&loop=false`;
const open = `https://docs.google.com/presentation/d/${id}/present`;
---

<figure class="slides">
  <div class="frame">
    <iframe
      src={src}
      title={title ?? 'Google Slides presentation'}
      loading="lazy"
      allowfullscreen
    ></iframe>
  </div>
  <figcaption>
    {title && <span>{title}</span>}
    <a href={open} target="_blank" rel="noopener noreferrer">Open in Slides &rarr;</a>
  </figcaption>
</figure>

<style>
  .slides { margin: 1.25rem 0; }
  .frame {
    position: relative;
    aspect-ratio: 16 / 9;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    overflow: hidden;
    background: var(--bg-subtle);
  }
  .frame iframe {
    border: 0;
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }
  figcaption {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1rem;
    justify-content: space-between;
    font-size: 0.85rem;
    color: var(--text-muted);
    margin-top: 0.5rem;
  }
</style>
