---
import BaseLayout from '../../layouts/BaseLayout.astro';
import FeatureList from '../../components/FeatureList.astro';
import { getCollection } from 'astro:content';

const projects = (await getCollection('projects', (p) => !p.data.draft)).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);
const fmt = (d: Date) =>
  d.toLocaleDateString('en-US', { year: 'numeric', month: 'short' });
---

<BaseLayout
  title="Projects"
  description="Personal software and hardware projects by Conner Glover."
>
  <div class="wrap wide">
    <header class="head">
      <p class="eyebrow">Personal work</p>
      <h1>Projects</h1>
      <p class="blurb">
        Things I&rsquo;ve built on my own time. Each one gets a full write-up: what
        it does, why I built it, and what I learned.
      </p>
    </header>

    {projects.length === 0 ? (
      <p class="muted">
        No projects published yet. Add a Markdown file to{' '}
        <code>src/content/projects/</code> &mdash; see{' '}
        <code>_template.md</code> for the frontmatter.
      </p>
    ) : (
      <FeatureList
        items={projects.map((p) => ({
          href: `/projects/${p.id}/`,
          title: p.data.title,
          summary: p.data.summary,
          meta: fmt(p.data.date),
          tags: p.data.tech,
        }))}
      />
    )}
  </div>
</BaseLayout>

<style>
  .head { margin-bottom: 2.5rem; }
  .head h1 { margin-bottom: 0.5rem; }
  .blurb { color: var(--text-muted); max-width: 58ch; margin: 0; }
</style>
