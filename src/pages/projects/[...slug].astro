---
import type { GetStaticPaths } from 'astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection, render } from 'astro:content';

export const getStaticPaths = (async () => {
  const projects = await getCollection('projects', (p) => !p.data.draft);
  return projects.map((p) => ({ params: { slug: p.id }, props: { project: p } }));
}) satisfies GetStaticPaths;

const { project } = Astro.props;
const { Content, headings } = await render(project);

const fmt = (d: Date) =>
  d.toLocaleDateString('en-US', { year: 'numeric', month: 'long' });
const toc = headings.filter((h) => h.depth === 2);
---

<BaseLayout title={project.data.title} description={project.data.summary}>
  <div class="wrap stack">
    <p class="eyebrow"><a href="/projects/">Projects</a></p>

    <header class="prose">
      <h1>{project.data.title}</h1>
      <p class="lede">{project.data.summary}</p>
      <p class="muted meta">
        <span>{fmt(project.data.date)}</span>
        {project.data.updated && <span>Updated {fmt(project.data.updated)}</span>}
        {project.data.repo && (
          <a href={project.data.repo} target="_blank" rel="noopener noreferrer">Source</a>
        )}
        {project.data.demo && (
          <a href={project.data.demo} target="_blank" rel="noopener noreferrer">Live demo</a>
        )}
      </p>
      {project.data.tech.length > 0 && (
        <ul class="tag-row rim-host">
          {project.data.tech.map((t) => <li class="tag rim-follow">{t}</li>)}
        </ul>
      )}
    </header>

    {project.data.cover && (
      <figure>
        <img src={project.data.cover.src} alt={project.data.cover.alt} />
      </figure>
    )}

    {toc.length > 2 && (
      <nav class="toc glass-pane" aria-label="On this page">
        <p class="eyebrow">On this page</p>
        <ul>
          {toc.map((h) => <li><a href={`#${h.slug}`}>{h.text}</a></li>)}
        </ul>
      </nav>
    )}

    <article class="prose body"><Content /></article>
  </div>
</BaseLayout>

<style>
  .lede { font-size: 1.1rem; }
  .meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.25rem;
    font-size: 0.9rem;
  }
  /* Frame, fill and blur come from .glass-pane in global.css — held lit,
     since this is furniture rather than something you aim at. Its rim tracks
     the cursor from anywhere on the page for the same reason: the glass never
     goes away, so neither does the light in it. */
  .toc {
    padding: 1rem 1.2rem;
    max-width: var(--measure);
  }
  .toc ul { margin: 0; padding-left: 1.1rem; }
  .body :global(h2) { scroll-margin-top: 1rem; }
  .body :global(img) {
    border: 1px solid var(--border);
    border-radius: var(--radius);
  }
</style>
