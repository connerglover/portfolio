---
import BaseLayout from '../layouts/BaseLayout.astro';
import { site } from '../data/site';
import { courseLevelKey, gpa, terms } from '../data/academics';
---

<BaseLayout title="About" description={`About ${site.name}`}>
  <div class="wrap stack">
    <section class="prose">
      <h1>About me</h1>
      <!--
        TODO(conner): this is still close to what the Google Site said in
        freshman year. The grade level is updated to match the transcript, but
        the rest is two years old — rewrite it when you get a chance.
      -->
      <p>
        I&rsquo;m a junior at Carmel Catholic High School, working through the
        Project Lead The Way engineering sequence. If there&rsquo;s anything I can do
        for you, please reach out.
      </p>
    </section>

    <section>
      <h2>Academic record</h2>
      <p class="gpa">
        <strong>{gpa.cumulative}</strong> weighted cumulative GPA
        <span class="muted"> &middot; {gpa.honors} &middot; as of {gpa.asOf}</span>
      </p>
      <p class="muted scale">
        Weighted on the school&rsquo;s scale, where course level sets the ceiling:
        AP and dual-credit courses top out at 5.00, Honors at 4.50, and college
        prep at 4.00. Letter grades follow the school scale &mdash; A is 100&ndash;90,
        B is 89&ndash;80, C is 79&ndash;70.
      </p>

      {terms.map((term) => (
        <div class="term">
          <h3>{term.label}</h3>
          {term.note && <p class="muted note">{term.note}</p>}
          <div class="table-scroll">
            <table>
              <thead>
                <tr>
                  <th scope="col">Course</th>
                  <th scope="col">Level</th>
                  <th scope="col" class="g">Sem 1</th>
                  <th scope="col" class="g">Sem 2</th>
                </tr>
              </thead>
              <tbody>
                {term.courses.map((c) => (
                  <tr>
                    <th scope="row">
                      {c.href ? <a href={c.href}>{c.name}</a> : c.name}
                      {c.summer && <span class="muted summer"> summer term</span>}
                    </th>
                    <td class="lvl">{c.level}</td>
                    <td class="g">{c.s1 ?? <span class="muted">{term.inProgress ? '·' : '—'}</span>}</td>
                    <td class="g">{c.s2 ?? <span class="muted">{term.inProgress ? '·' : '—'}</span>}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </div>
      ))}

      <p class="muted key">
        {courseLevelKey.map(([abbr, full], i) => (
          <>{i > 0 && ' · '}<abbr title={full}>{abbr}</abbr> {full}</>
        ))}
      </p>
    </section>

    {site.email && (
      <section class="prose">
        <h2>Contact</h2>
        <p><a href={`mailto:${site.email}`}>{site.email}</a></p>
      </section>
    )}
  </div>
</BaseLayout>

<style>
  .gpa {
    display: flex;
    align-items: baseline;
    flex-wrap: wrap;
    gap: 0.6rem;
    margin-bottom: 0.5rem;
  }
  .gpa strong {
    font-family: var(--font-mono);
    font-size: clamp(2.1rem, 1.6rem + 1.6vw, 2.75rem);
    font-weight: 600;
    line-height: 1;
    color: var(--accent-bright);
    letter-spacing: -0.03em;
  }
  .gpa span { font-size: 0.88rem; }

  .scale,
  .note,
  .key { max-width: var(--measure); font-size: 0.86rem; }

  .term { margin-top: 2.75rem; }
  .term h3 {
    font-size: 1.05rem;
    margin-bottom: 0.3rem;
  }
  .note {
    margin: 0 0 0.9rem;
    font-family: var(--font-mono);
    font-size: 0.74rem;
    letter-spacing: 0.03em;
    color: var(--text-faint);
  }

  /* Tables scroll inside their own box rather than pushing the page wide. */
  .table-scroll {
    overflow-x: auto;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--bg-subtle);
  }

  table {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.92rem;
  }
  th, td {
    text-align: left;
    padding: 0.6rem 0.95rem;
    border-bottom: 1px solid var(--border);
  }
  tbody tr:last-child th,
  tbody tr:last-child td { border-bottom: 0; }
  tbody tr { transition: background var(--dur) var(--ease); }
  tbody tr:hover { background: var(--bg-raised); }

  thead th {
    font-family: var(--font-mono);
    font-size: 0.66rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--text-faint);
    font-weight: 500;
    background: var(--bg);
    white-space: nowrap;
  }
  tbody th {
    font-weight: 450;
    color: var(--text);
    min-width: 15rem;
  }
  tbody th a { color: var(--text); border-bottom-color: color-mix(in srgb, var(--accent) 30%, transparent); }
  tbody th a:hover { color: var(--accent-bright); }

  .lvl {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    color: var(--text-faint);
    white-space: nowrap;
  }
  .g {
    width: 4.5rem;
    text-align: center;
    font-family: var(--font-mono);
    font-variant-numeric: tabular-nums;
  }
  tbody .g { font-weight: 600; color: var(--text); }

  .summer {
    font-family: var(--font-mono);
    font-size: 0.66rem;
    font-weight: 400;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--text-faint);
    white-space: nowrap;
  }

  .key abbr {
    text-decoration: none;
    font-family: var(--font-mono);
    font-weight: 600;
    color: var(--accent);
  }
</style>
