---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { courses, unitLabel } from '../../data/site';

const school = await getCollection('school');
const inUnit = (slug: string, unit: string) =>
  school.filter((a) => a.data.courseSlug === slug && a.data.unit === unit);
---

<BaseLayout
  title="School engineering"
  description="PLTW engineering coursework: Introduction to Engineering Design, Principles of Engineering, and Civil Engineering and Architecture."
>
  <div class="wrap stack">
    <section class="prose">
      <h1>School engineering</h1>
      <p>
        Coursework from Carmel Catholic&rsquo;s Project Lead The Way sequence. Each
        assignment gets a short write-up and, where the deck still exists, the
        original presentation.
      </p>
    </section>

    {courses.map((c) => (
      <section>
        <h2><a href={`/school/${c.slug}/`}>{c.name}</a></h2>
        <p class="muted">{c.blurb}</p>
        <div class="grid">
          {c.units.map((u) => (
            <article class="card">
              <h3><a href={`/school/${c.slug}/${u}/`}>{unitLabel(u)}</a></h3>
              <p class="muted">
                {inUnit(c.slug, u).some((a) => a.data.status === 'not-started')
                  ? <>{inUnit(c.slug, u).filter((a) => a.data.status === 'complete').length} of {inUnit(c.slug, u).length} done</>
                  : <>{inUnit(c.slug, u).length} assignments</>}
              </p>
            </article>
          ))}
        </div>
      </section>
    ))}
  </div>
</BaseLayout>

<style>
  h2 a, h3 a { color: var(--text); border: 0; }
  h2 a:hover, h3 a:hover { color: var(--accent-bright); }
  .card p.muted {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.06em;
    color: var(--text-faint);
    margin-bottom: 0;
  }
</style>
